# ApexCrestVest Environment Variables
# ================================

# Resend.com API Key for email notifications
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=

# The "from" email address — must be from a verified domain in Resend
# Format: "YourName <your@email.com>"
RESEND_FROM_EMAIL=ApexCrestVest <noreply@apexcrestvest.com>
# Reply-To address — when users hit "reply" in their email client, it goes here
# Set this to an inbox you actually monitor (e.g. support@apexcrestvest.com)
RESEND_REPLY_TO=support@apexcrestvest.com

# The public URL of your deployed app (used in email links & referral URLs)
# Production: https://apexcrestvest.com
FRONTEND_URL=https://apexcrestvest.com

# Server port
PORT=3000

# Database path — for Railway/Render, set this to a persistent volume path
# e.g., /data/apexcrestvest.db (create a volume mounted at /data)
DB_PATH=
