# NovaVest Environment Variables
# ================================

# Resend.com API Key for email notifications
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=

# The "from" email address — must be from a verified domain in Resend
# Format: "YourName <your@email.com>"
RESEND_FROM_EMAIL=NovaVest <noreply@novavest.com>

# The public URL of your deployed app (used in email links)
FRONTEND_URL=http://localhost:3000

# Server port
PORT=3000

# Database path — for Railway/Render, set this to a persistent volume path
# e.g., /data/novavest.db (create a volume mounted at /data)
DB_PATH=
