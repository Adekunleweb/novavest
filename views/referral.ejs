<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="dash-layout">
  <%- include('partials/dash-sidebar', { active }) %>
  <main class="dash-main">
    <div class="dash-header">
      <div>
        <h1>Referral Program 🎁</h1>
        <div class="sub">Invite friends and earn $700 for every signup</div>
      </div>
    </div>

    <!-- Referral Stats -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon gold">👥</div>
        <div class="stat-val"><%= referrals.length %></div>
        <div class="stat-lbl">People Referred</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon green">💰</div>
        <div class="stat-val">$<%= totalReferralEarnings.toLocaleString(undefined, {minimumFractionDigits:2}) %></div>
        <div class="stat-lbl">Referral Earnings</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon blue">🚀</div>
        <div class="stat-val">$700</div>
        <div class="stat-lbl">Per Referral</div>
      </div>
    </div>

    <!-- Referral Link -->
    <div class="dash-panel">
      <div class="dash-panel-title">Your Referral Link</div>
      <p style="color:var(--gray); margin-bottom:16px;">Share this link with friends, family, and your network. Every person who signs up through your link earns you $700 instantly!</p>
      <div class="referral-link-box" style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
        <input type="text" id="refLink" value="<%= referralLink %>" readonly style="flex:1; min-width:200px; padding:14px 18px; background:var(--navy); border:1px solid rgba(212,175,55,0.3); border-radius:10px; color:var(--gold); font-size:15px; font-weight:600;">
        <button onclick="copyRefLink()" class="btn btn-gold" style="white-space:nowrap;">📋 Copy Link</button>
      </div>
      <div id="copyMsg" style="display:none; color:var(--green); margin-top:12px; font-weight:600;">✅ Link copied to clipboard! Share it with your friends.</div>
    </div>

    <!-- How It Works -->
    <div class="dash-panel">
      <div class="dash-panel-title">How It Works</div>
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:8px;">
        <div style="text-align:center; padding:20px;">
          <div style="font-size:32px; margin-bottom:8px;">1️⃣</div>
          <div style="font-weight:700; color:var(--white); margin-bottom:4px;">Share Your Link</div>
          <div style="color:var(--gray); font-size:13px;">Send your unique referral link to friends and family via social media, WhatsApp, email, or text.</div>
        </div>
        <div style="text-align:center; padding:20px;">
          <div style="font-size:32px; margin-bottom:8px;">2️⃣</div>
          <div style="font-weight:700; color:var(--white); margin-bottom:4px;">They Sign Up</div>
          <div style="color:var(--gray); font-size:13px;">Your friend creates a free account using your link and gets $1,000 sign up bonus instantly.</div>
        </div>
        <div style="text-align:center; padding:20px;">
          <div style="font-size:32px; margin-bottom:8px;">3️⃣</div>
          <div style="font-weight:700; color:var(--white); margin-bottom:4px;">You Earn $700</div>
          <div style="color:var(--gray); font-size:13px;">You receive $700 automatically in your balance for every successful referral. No limits!</div>
        </div>
      </div>
    </div>

    <!-- Referral History -->
    <div class="dash-panel">
      <div class="dash-panel-title">Your Referrals</div>
      <% if (referrals.length === 0) { %>
        <p style="color:var(--gray); text-align:center; padding:40px;">No referrals yet. Start sharing your link to earn $700 per signup! 🚀</p>
      <% } else { %>
        <table class="table">
          <thead><tr><th>#</th><th>Name</th><th>Date Joined</th><th>Your Bonus</th></tr></thead>
          <tbody>
            <% referrals.forEach(function(r, i) { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><%= r.full_name %></td>
                <td><%= new Date(r.created_at).toLocaleDateString() %></td>
                <td style="color:var(--green); font-weight:700;">+$700.00</td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
</div>

<script>
function copyRefLink() {
  const input = document.getElementById('refLink');
  input.select();
  input.setSelectionRange(0, 99999);
  try {
    navigator.clipboard.writeText(input.value).then(() => {
      showCopied();
    }).catch(() => {
      document.execCommand('copy');
      showCopied();
    });
  } catch(e) {
    document.execCommand('copy');
    showCopied();
  }
}
function showCopied() {
  const msg = document.getElementById('copyMsg');
  msg.style.display = 'block';
  setTimeout(() => { msg.style.display = 'none'; }, 3000);
}
</script>
</body>
</html>
