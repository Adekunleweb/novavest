<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password - ApexCrestVest</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <a href="/" class="logo">Apex<span>CrestVest</span></a>
      <h2>Reset Your Password</h2>
      <p>Enter your new password below</p>
    </div>

    <% if (error) { %>
      <div class="auth-error"><%= error %></div>
      <div class="auth-footer">
        <a href="/forgot-password">Request a new reset link</a>
      </div>
    <% } else { %>
    <form action="/reset-password?token=<%= token %>" method="POST">
      <div class="form-group">
        <label>New Password</label>
        <input type="password" name="password" class="form-control" placeholder="Enter new password" required minlength="6">
      </div>
      <div class="form-group">
        <label>Confirm New Password</label>
        <input type="password" name="confirm_password" class="form-control" placeholder="Re-enter new password" required minlength="6">
      </div>
      <button type="submit" class="btn btn-gold btn-block" style="margin-top:8px;">Reset Password →</button>
    </form>
    <% } %>

    <div class="auth-footer">
      <a href="/login">Back to Login</a>
    </div>
  </div>
</div>

</body>
</html>
