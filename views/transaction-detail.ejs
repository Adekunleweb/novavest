<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .txn-detail-wrap { max-width: 820px; margin: 0 auto; }
    .txn-back { display: inline-flex; align-items: center; gap: 8px; color: var(--gray); text-decoration: none; font-size: 14px; font-weight: 500; margin-bottom: 20px; transition: color 0.2s; }
    .txn-back:hover { color: var(--gold); }
    .txn-receipt {
      background: linear-gradient(145deg, #0f1f38, #142a4a);
      border: 1px solid #1e3a5f;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }
    .txn-receipt-header {
      background: linear-gradient(135deg, #0a1628, #1a2f4e);
      padding: 28px 32px;
      border-bottom: 2px solid var(--gold);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }
    .txn-receipt-header h2 { margin: 0; color: var(--gold); font-size: 22px; display: flex; align-items: center; gap: 10px; }
    .txn-status-badge {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 16px; border-radius: 20px; font-size: 13px; font-weight: 600;
    }
    .txn-status-badge.completed { background: rgba(46,204,113,0.15); color: #2ecc71; border: 1px solid rgba(46,204,113,0.3); }
    .txn-status-badge.pending { background: rgba(240,173,78,0.15); color: #f0ad4e; border: 1px solid rgba(240,173,78,0.3); }
    .txn-status-badge .dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; animation: pulse 2s infinite; }
    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }

    .txn-amount-section {
      padding: 36px 32px 28px;
      text-align: center;
      border-bottom: 1px solid #1e3a5f;
    }
    .txn-amount-label { color: var(--gray); font-size: 13px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
    .txn-amount-value { font-size: 42px; font-weight: 800; color: #e6f1ff; }
    .txn-amount-value.deposit { color: #2ecc71; }
    .txn-amount-value.withdrawal { color: #e74c3c; }
    .txn-amount-value.interest, .txn-amount-value.bonus, .txn-amount-value.investment { color: var(--gold); }
    .txn-type-tag {
      display: inline-block; margin-top: 10px;
      padding: 4px 14px; border-radius: 6px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;
    }
    .txn-type-tag.deposit { background: rgba(46,204,113,0.12); color: #2ecc71; }
    .txn-type-tag.withdrawal { background: rgba(231,76,60,0.12); color: #e74c3c; }
    .txn-type-tag.interest { background: rgba(212,175,55,0.12); color: var(--gold); }
    .txn-type-tag.bonus { background: rgba(212,175,55,0.12); color: var(--gold); }
    .txn-type-tag.investment { background: rgba(102,179,255,0.12); color: #66b3ff; }

    .txn-details-grid { padding: 0; }
    .txn-detail-row {
      display: flex; align-items: flex-start; justify-content: space-between;
      padding: 18px 32px; border-bottom: 1px solid rgba(30,58,95,0.5);
      gap: 16px;
    }
    .txn-detail-row:last-child { border-bottom: none; }
    .txn-detail-label { color: var(--gray); font-size: 14px; font-weight: 500; white-space: nowrap; min-width: 140px; }
    .txn-detail-value { color: #e6f1ff; font-size: 14px; font-weight: 500; text-align: right; word-break: break-all; }
    .txn-detail-value.mono { font-family: 'JetBrains Mono', monospace; font-size: 13px; }
    .txn-detail-value .copy-btn {
      display: inline-flex; align-items: center; gap: 4px;
      background: rgba(212,175,55,0.1); border: 1px solid rgba(212,175,55,0.2);
      color: var(--gold); padding: 3px 10px; border-radius: 5px; cursor: pointer;
      font-size: 11px; font-weight: 600; margin-left: 8px; transition: all 0.2s;
    }
    .txn-detail-value .copy-btn:hover { background: rgba(212,175,55,0.2); }

    .txn-confirmation-bar {
      padding: 20px 32px;
      background: rgba(46,204,113,0.05);
      border-top: 1px solid rgba(46,204,113,0.15);
      display: flex; align-items: center; gap: 12px;
    }
    .txn-conf-icon {
      width: 40px; height: 40px; border-radius: 50%;
      background: rgba(46,204,113,0.15); display: flex; align-items: center; justify-content: center;
      font-size: 20px; flex-shrink: 0;
    }
    .txn-conf-text { color: #a8b2d1; font-size: 13px; line-height: 1.5; }
    .txn-conf-text strong { color: #2ecc71; }

    .txn-explorer-link {
      display: block; text-align: center; padding: 16px;
      background: rgba(212,175,55,0.08); border-top: 1px solid rgba(212,175,55,0.15);
      color: var(--gold); text-decoration: none; font-size: 14px; font-weight: 600;
      transition: background 0.2s;
    }
    .txn-explorer-link:hover { background: rgba(212,175,55,0.15); }

    .txn-receipt-footer {
      padding: 16px 32px; text-align: center;
      background: #0a1628; color: #5c6f8a; font-size: 11px; line-height: 1.6;
    }

    @media (max-width: 568px) {
      .txn-receipt-header { padding: 20px; }
      .txn-amount-section { padding: 24px 20px; }
      .txn-amount-value { font-size: 32px; }
      .txn-detail-row { padding: 14px 20px; flex-direction: column; gap: 4px; }
      .txn-detail-label { min-width: auto; }
      .txn-detail-value { text-align: left; }
      .txn-confirmation-bar { padding: 16px 20px; }
    }
  </style>
</head>
<body>
<div class="dash-layout">
  <%- include('partials/dash-sidebar', { active }) %>
  <main class="dash-main">
    <div class="txn-detail-wrap">
      <a href="/transactions" class="txn-back">← Back to Transaction History</a>

      <div class="txn-receipt">
        <!-- Header -->
        <div class="txn-receipt-header">
          <h2>
            <% if (txn.type === 'deposit') { %>💰<% } else if (txn.type === 'withdrawal') { %>🏦<% } else if (txn.type === 'interest') { %>📈<% } else if (txn.type === 'bonus') { %>🎁<% } else if (txn.type === 'investment') { %>💹<% } else { %>📋<% } %>
            Transaction Receipt
          </h2>
          <div class="txn-status-badge <%= txn.status %>">
            <span class="dot"></span>
            <%= txn.status === 'completed' ? 'Confirmed' : txn.status %>
          </div>
        </div>

        <!-- Amount -->
        <div class="txn-amount-section">
          <div class="txn-amount-label">
            <% if (txn.type === 'deposit') { %>Deposited Amount<% } else if (txn.type === 'withdrawal') { %>Withdrawn Amount<% } else if (txn.type === 'interest') { %>Interest Earned<% } else if (txn.type === 'bonus') { %>Bonus Credited<% } else if (txn.type === 'investment') { %>Investment Amount<% } else { %>Amount<% } %>
          </div>
          <div class="txn-amount-value <%= txn.type %>">
            <%= txn.type === 'withdrawal' ? '-' : '+' %>$<%= formattedAmount %>
          </div>
          <div class="txn-type-tag <%= txn.type %>"><%= txn.type %></div>
        </div>

        <!-- Details Grid -->
        <div class="txn-details-grid">
          <div class="txn-detail-row">
            <div class="txn-detail-label">Transaction Hash</div>
            <div class="txn-detail-value mono">
              <%= txHash.substring(0, 20) %>...<%= txHash.substring(txHash.length - 12) %>
              <span class="copy-btn" onclick="copyText('<%= txHash %>', this)">📋 Copy</span>
            </div>
          </div>

          <div class="txn-detail-row">
            <div class="txn-detail-label">Status</div>
            <div class="txn-detail-value">
              <% if (txn.status === 'completed') { %>
                <span style="color:#2ecc71;">✓ Confirmed & Credited</span>
              <% } else if (txn.status === 'pending') { %>
                <span style="color:#f0ad4e;">⏳ Pending Confirmation</span>
              <% } else { %>
                <span style="color:#e74c3c;">✗ <%= txn.status %></span>
              <% } %>
            </div>
          </div>

          <div class="txn-detail-row">
            <div class="txn-detail-label">Date & Time</div>
            <div class="txn-detail-value"><%= new Date(txn.created_at).toLocaleString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' }) %></div>
          </div>

          <div class="txn-detail-row">
            <div class="txn-detail-label">Block</div>
            <div class="txn-detail-value mono">#<%= blockHeight.toLocaleString() %></div>
          </div>

          <div class="txn-detail-row">
            <div class="txn-detail-label">Confirmations</div>
            <div class="txn-detail-value" style="color:#2ecc71;"><%= confirmations %> confirmations</div>
          </div>

          <div class="txn-detail-row">
            <div class="txn-detail-label">Network</div>
            <div class="txn-detail-value"><%= network %></div>
          </div>

          <div class="txn-detail-row">
            <div class="txn-detail-label">From</div>
            <div class="txn-detail-value mono"><%= fromAddr %></div>
          </div>

          <div class="txn-detail-row">
            <div class="txn-detail-label">To</div>
            <div class="txn-detail-value mono"><%= toAddr %></div>
          </div>

          <% if (gasFee > 0) { %>
          <div class="txn-detail-row">
            <div class="txn-detail-label">Network Fee</div>
            <div class="txn-detail-value" style="color:var(--gray);"><%= gasFee.toFixed(8) %> <%= network.includes('Bitcoin') ? 'BTC' : network.includes('Ethereum') ? 'ETH' : 'TRX' %></div>
          </div>
          <% } %>

          <div class="txn-detail-row">
            <div class="txn-detail-label">Description</div>
            <div class="txn-detail-value"><%= txn.description %></div>
          </div>

          <div class="txn-detail-row">
            <div class="txn-detail-label">Transaction ID</div>
            <div class="txn-detail-value mono">NV-<%= String(txn.id).padStart(8, '0') %></div>
          </div>
        </div>

        <!-- Confirmation bar -->
        <% if (txn.status === 'completed') { %>
        <div class="txn-confirmation-bar">
          <div class="txn-conf-icon">✓</div>
          <div class="txn-conf-text">
            <strong>Transaction Verified</strong><br>
            This transaction has been confirmed on the <%= network %> network with <%= confirmations %> confirmations.
            <% if (txn.type === 'deposit') { %>Your account balance has been credited.<% } %>
            <% if (txn.type === 'interest' || txn.type === 'bonus') { %>Funds have been added to your available balance.<% } %>
            <% if (txn.type === 'withdrawal') { %>Funds have been sent to your wallet address.<% } %>
          </div>
        </div>
        <% } else if (txn.status === 'pending') { %>
        <div class="txn-confirmation-bar" style="background:rgba(240,173,78,0.05); border-top-color:rgba(240,173,78,0.15);">
          <div class="txn-conf-icon" style="background:rgba(240,173,78,0.15); color:#f0ad4e;">⏳</div>
          <div class="txn-conf-text">
            <strong style="color:#f0ad4e;">Awaiting Confirmation</strong><br>
            This transaction is being processed. You will be notified once it's confirmed.
          </div>
        </div>
        <% } %>

        <!-- Explorer link (decorative) -->
        <a href="/transactions" class="txn-explorer-link">🔗 View on Blockchain Explorer →</a>

        <!-- Footer -->
        <div class="txn-receipt-footer">
          This receipt was generated by ApexCrestVest on <%= new Date().toLocaleString() %><br>
          Transaction ID NV-<%= String(txn.id).padStart(8, '0') %> · <%= network %>
        </div>
      </div>

      <p style="text-align:center; color:var(--gray); font-size:12px; margin-top:20px;">
        Need help with this transaction? <a href="/support" style="color:var(--gold); text-decoration:none;">Contact Support →</a>
      </p>
    </div>
  </main>
</div>

<script>
function copyText(text, btn) {
  navigator.clipboard.writeText(text).then(() => {
    const original = btn.innerHTML;
    btn.innerHTML = '✓ Copied!';
    btn.style.background = 'rgba(46,204,113,0.2)';
    btn.style.color = '#2ecc71';
    btn.style.borderColor = 'rgba(46,204,113,0.3)';
    setTimeout(() => {
      btn.innerHTML = original;
      btn.style.background = '';
      btn.style.color = '';
      btn.style.borderColor = '';
    }, 2000);
  });
}
</script>
</body>
</html>
