<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <a href="/" class="logo">Apex<span>CrestVest</span></a>
      <h2>Welcome Back</h2>
      <p>Login to access your investment dashboard</p>
    </div>

    <% if (error) { %>
      <div class="auth-error"><%= error %></div>
    <% } %>
    <% if (typeof success_msg !== 'undefined' && success_msg) { %>
      <div class="auth-error" style="background:rgba(46,204,113,0.1);color:#2ecc71;border-color:rgba(46,204,113,0.3);">
        ✅ <%= success_msg %>
      </div>
    <% } %>

    <form action="/login" method="POST">
      <div class="form-group">
        <label>Email Address</label>
        <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" class="form-control" placeholder="Your password" required>
      </div>
      <div style="text-align:right;margin:-8px 0 16px;">
        <a href="/forgot-password" style="color:#d4af37;font-size:14px;text-decoration:none;font-weight:500;">Forgot password?</a>
      </div>
      <button type="submit" class="btn btn-gold btn-block" style="margin-top:0px;">Login →</button>
    </form>

    <div class="auth-footer">
      Don't have an account? <a href="/signup">Sign up free</a>
    </div>
  </div>
</div>

</body>
</html>
