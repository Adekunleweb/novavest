<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password - NovaVest</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <a href="/" class="logo">Nova<span>Vest</span></a>
      <h2>Forgot Password?</h2>
      <p>Enter your email address and we'll send you a link to reset your password</p>
    </div>

    <% if (error) { %>
      <div class="auth-error"><%= error %></div>
    <% } %>

    <% if (success) { %>
      <div class="auth-error" style="background:rgba(46,204,113,0.1);color:#2ecc71;border-color:rgba(46,204,113,0.3);">
        ✅ <%= success %>
      </div>
    <% } else { %>
    <form action="/forgot-password" method="POST">
      <div class="form-group">
        <label>Email Address</label>
        <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
      </div>
      <button type="submit" class="btn btn-gold btn-block" style="margin-top:8px;">Send Reset Link →</button>
    </form>
    <% } %>

    <div class="auth-footer">
      Remember your password? <a href="/login">Login here</a>
    </div>
  </div>
</div>

</body>
</html>
