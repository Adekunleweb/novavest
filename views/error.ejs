<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .error-wrap {
      max-width: 560px;
      margin: 80px auto;
      text-align: center;
      padding: 0 20px;
    }
    .error-code {
      font-size: 96px;
      font-weight: 800;
      color: var(--gold);
      line-height: 1;
      margin-bottom: 16px;
      text-shadow: 0 4px 30px rgba(212,175,55,0.3);
    }
    .error-icon {
      font-size: 56px;
      margin-bottom: 20px;
    }
    .error-title {
      color: #e6f1ff;
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 12px;
    }
    .error-msg {
      color: var(--gray);
      font-size: 16px;
      line-height: 1.6;
      margin-bottom: 32px;
    }
    .error-actions {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .error-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 28px;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s;
    }
    .error-btn.primary {
      background: var(--gold);
      color: #0a1628;
    }
    .error-btn.primary:hover {
      background: #e6c247;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(212,175,55,0.3);
    }
    .error-btn.secondary {
      background: rgba(255,255,255,0.05);
      color: #e6f1ff;
      border: 1px solid rgba(255,255,255,0.1);
    }
    .error-btn.secondary:hover {
      background: rgba(255,255,255,0.1);
    }
  </style>
</head>
<body>
  <div class="error-wrap">
    <div class="error-icon">🔍</div>
    <div class="error-code">404</div>
    <h1 class="error-title">Page Not Found</h1>
    <p class="error-msg"><%= message %></p>
    <div class="error-actions">
      <a href="/dashboard" class="error-btn primary">📊 Go to Dashboard</a>
      <a href="/transactions" class="error-btn secondary">📋 Transaction History</a>
    </div>
  </div>
</body>
</html>
