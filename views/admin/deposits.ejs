<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="admin-layout">
  <%- include('../partials/admin-sidebar', { active }) %>
  <main class="admin-main">
    <div class="admin-header">
      <div>
        <h1>Deposits</h1>
        <div class="sub" style="color:var(--gray);">Approve or reject user deposit requests</div>
      </div>
    </div>

    <div class="dash-panel">
      <% if (deposits.length === 0) { %>
        <p style="color:var(--gray); text-align:center; padding:40px;">No deposits yet.</p>
      <% } else { %>
        <table class="table">
          <thead><tr><th>Date</th><th>User</th><th>Email</th><th>Currency</th><th>Amount</th><th>Wallet Address</th><th>TX Hash</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody>
            <% deposits.forEach(function(d) { %>
              <tr>
                <td style="font-size:12px;"><%= new Date(d.created_at).toLocaleString() %></td>
                <td style="font-weight:600;"><%= d.full_name %></td>
                <td style="font-size:12px;"><%= d.email %></td>
                <td><%= d.currency %></td>
                <td>$<%= d.amount.toLocaleString() %></td>
                <td style="font-family:monospace; font-size:11px;"><%= d.wallet_address ? d.wallet_address.substring(0,20)+'...' : '—' %></td>
                <td style="font-family:monospace; font-size:11px;"><%= d.tx_hash ? d.tx_hash.substring(0,16)+'...' : '—' %></td>
                <td><span class="badge badge-<%= d.status %>"><%= d.status %></span></td>
                <td>
                  <% if (d.status === 'pending') { %>
                    <form action="/admin/deposits/<%= d.id %>/approve" method="POST" style="display:inline;"><button class="btn btn-gold btn-sm" style="padding:4px 12px;">✓ Approve</button></form>
                    <form action="/admin/deposits/<%= d.id %>/reject" method="POST" style="display:inline;"><button class="btn btn-navy btn-sm" style="padding:4px 12px;">✗ Reject</button></form>
                  <% } else { %>
                    <span style="color:var(--gray); font-size:12px;">—</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>
