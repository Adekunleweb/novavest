<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="admin-layout">
  <%- include('../partials/admin-sidebar', { active }) %>
  <main class="admin-main">
    <div class="admin-header">
      <div>
        <h1>Deposit Wallets</h1>
        <div class="sub" style="color:var(--gray);">Manage the crypto wallets users copy when depositing</div>
      </div>
    </div>

    <!-- Add new wallet -->
    <div class="dash-panel">
      <div class="dash-panel-title">Add New Wallet</div>
      <form action="/admin/wallets/add" method="POST">
        <div class="form-row" style="grid-template-columns:1fr 1fr 2fr;">
          <div class="form-group">
            <label>Currency</label>
            <input type="text" name="currency" class="form-control" placeholder="e.g. Bitcoin" required>
          </div>
          <div class="form-group">
            <label>Network</label>
            <input type="text" name="network" class="form-control" placeholder="e.g. BTC Network / TRC-20" required>
          </div>
          <div class="form-group">
            <label>Wallet Address</label>
            <input type="text" name="address" class="form-control" placeholder="Paste wallet address" required>
          </div>
        </div>
        <button type="submit" class="btn btn-gold">+ Add Wallet</button>
      </form>
    </div>

    <!-- Existing wallets -->
    <div class="dash-panel">
      <div class="dash-panel-title">Current Wallets (<%= wallets.length %>)</div>
      <p style="color:var(--gray); font-size:13px; margin-bottom:20px;">Edit the address or details anytime. Changes take effect immediately for all users depositing.</p>
      
      <% if (wallets.length === 0) { %>
        <p style="color:var(--gray); text-align:center; padding:40px;">No wallets yet. Add one above.</p>
      <% } else { %>
        <div class="wallet-grid">
          <% wallets.forEach(function(w) { %>
            <div class="wallet-card" style="cursor:default;">
              <form action="/admin/wallets/<%= w.id %>/update" method="POST">
                <div class="form-group">
                  <label>Currency</label>
                  <input type="text" name="currency" class="form-control" value="<%= w.currency %>" required>
                </div>
                <div class="form-group">
                  <label>Network</label>
                  <input type="text" name="network" class="form-control" value="<%= w.network %>" required>
                </div>
                <div class="form-group">
                  <label>Wallet Address</label>
                  <input type="text" name="address" class="form-control" value="<%= w.address %>" required style="font-family:monospace; font-size:12px;">
                </div>
                <div class="form-group">
                  <label>
                    <input type="checkbox" name="active" <%= w.active ? 'checked' : '' %>> Active (visible to users)
                  </label>
                </div>
                <div style="display:flex; gap:8px;">
                  <button type="submit" class="btn btn-gold btn-sm" style="flex:1;">💾 Save</button>
                </div>
              </form>
              <form action="/admin/wallets/<%= w.id %>/delete" method="POST" onsubmit="return confirm('Delete this wallet?')">
                <button type="submit" class="btn btn-navy btn-sm btn-block" style="margin-top:8px;">🗑 Delete Wallet</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>
