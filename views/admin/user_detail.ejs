<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="admin-layout">
  <%- include('../partials/admin-sidebar', { active }) %>
  <main class="admin-main">
    <div class="admin-header">
      <div>
        <h1><%= user.full_name %></h1>
        <div class="sub" style="color:var(--gray);"><%= user.email %> · <%= user.country %></div>
      </div>
      <a href="/admin/users" class="btn btn-outline btn-sm">← Back to Users</a>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon gold">💵</div>
        <div class="stat-val">$<%= (user.balance || 0).toLocaleString(undefined,{minimumFractionDigits:2}) %></div>
        <div class="stat-lbl">Current Balance</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon green">📉</div>
        <div class="stat-val">$<%= (user.total_deposited || 0).toLocaleString(undefined,{minimumFractionDigits:2}) %></div>
        <div class="stat-lbl">Total Deposited</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon blue">📈</div>
        <div class="stat-val">$<%= (user.total_earned || 0).toLocaleString(undefined,{minimumFractionDigits:2}) %></div>
        <div class="stat-lbl">Total Earned</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon purple">🎯</div>
        <div class="stat-val"><%= investments.filter(i=>i.status==='active').length %></div>
        <div class="stat-lbl">Active Investments</div>
      </div>
    </div>

    <div class="detail-grid">
      <div class="dash-panel">
        <div class="dash-panel-title">All Signup Details</div>
        <div class="info-row"><span class="lbl">Full Name</span><span class="val"><%= user.full_name %></span></div>
        <div class="info-row"><span class="lbl">Email</span><span class="val"><%= user.email %></span></div>
        <div class="info-row"><span class="lbl">Phone</span><span class="val"><%= user.phone || '—' %></span></div>
        <div class="info-row"><span class="lbl">Country</span><span class="val"><%= user.country || '—' %></span></div>
        <div class="info-row"><span class="lbl">Address</span><span class="val"><%= user.address || '—' %></span></div>
        <div class="info-row"><span class="lbl">ID Type</span><span class="val"><%= user.id_type || '—' %></span></div>
        <div class="info-row"><span class="lbl">National ID</span><span class="val"><%= user.national_id || '—' %></span></div>
        <div class="info-row"><span class="lbl">Status</span><span class="val"><%= user.status %></span></div>
        <div class="info-row"><span class="lbl">Joined</span><span class="val"><%= new Date(user.created_at).toLocaleString() %></span></div>
        
        <div style="margin-top:20px; display:flex; gap:10px;">
          <form action="/admin/users/<%= user.id %>/status" method="POST" style="flex:1;">
            <input type="hidden" name="status" value="active">
            <button class="btn btn-gold btn-block btn-sm" <%= user.status==='active' ? 'disabled' : '' %>>Activate</button>
          </form>
          <form action="/admin/users/<%= user.id %>/status" method="POST" style="flex:1;">
            <input type="hidden" name="status" value="blocked">
            <button class="btn btn-navy btn-block btn-sm" <%= user.status==='blocked' ? 'disabled' : '' %>>Block</button>
          </form>
        </div>
      </div>

      <div class="dash-panel">
        <div class="dash-panel-title">Deposits</div>
        <% if (deposits.length === 0) { %>
          <p style="color:var(--gray); text-align:center; padding:20px; font-size:14px;">No deposits.</p>
        <% } else { %>
          <table class="table">
            <thead><tr><th>Date</th><th>Currency</th><th>Amount</th><th>Status</th></tr></thead>
            <tbody>
              <% deposits.forEach(function(d) { %>
                <tr><td style="font-size:12px;"><%= new Date(d.created_at).toLocaleDateString() %></td><td><%= d.currency %></td><td>$<%= d.amount %></td><td><span class="badge badge-<%= d.status %>"><%= d.status %></span></td></tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
        
        <div class="dash-panel-title" style="margin-top:20px;">Investments</div>
        <% if (investments.length === 0) { %>
          <p style="color:var(--gray); text-align:center; padding:20px; font-size:14px;">No investments.</p>
        <% } else { %>
          <table class="table">
            <thead><tr><th>Date</th><th>Amount</th><th>ROI</th><th>Status</th></tr></thead>
            <tbody>
              <% investments.forEach(function(inv) { %>
                <tr><td style="font-size:12px;"><%= new Date(inv.created_at).toLocaleDateString() %></td><td>$<%= inv.amount %></td><td><%= inv.roi_percent %>%</td><td><span class="badge badge-<%= inv.status %>"><%= inv.status %></span></td></tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>

    <div class="detail-grid" style="margin-top:24px;">
      <div class="dash-panel">
        <div class="dash-panel-title">Transactions</div>
        <% if (req_query_error === 'reason') { %>
          <div style="background:#fee2e2; color:#991b1b; padding:10px 14px; border-radius:8px; margin-bottom:12px; font-size:13px; font-weight:600;">⚠ A reason is required before reversing a transaction.</div>
        <% } %>
        <% if (req_query_error === 'notcompleted') { %>
          <div style="background:#fee2e2; color:#991b1b; padding:10px 14px; border-radius:8px; margin-bottom:12px; font-size:13px; font-weight:600;">⚠ Only approved (completed) transactions can be reversed.</div>
        <% } %>
        <% if (req_query_reversed) { %>
          <div style="background:#dcfce7; color:#166534; padding:10px 14px; border-radius:8px; margin-bottom:12px; font-size:13px; font-weight:600;">✓ Transaction reversed — balance adjusted and user emailed with your reason.</div>
        <% } %>
        <% if (req_query_restored) { %>
          <div style="background:#dcfce7; color:#166534; padding:10px 14px; border-radius:8px; margin-bottom:12px; font-size:13px; font-weight:600;">✓ Transaction restored — balance re-applied.</div>
        <% } %>
        <% if (transactions.length === 0) { %>
          <p style="color:var(--gray); text-align:center; padding:20px; font-size:14px;">No transactions.</p>
        <% } else { %>
          <table class="table">
            <thead><tr><th>Date</th><th>Type</th><th>Amount</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
              <% transactions.forEach(function(t) { %>
                <tr>
                  <td style="font-size:12px;"><%= new Date(t.created_at).toLocaleDateString() %></td>
                  <td style="text-transform:capitalize;"><%= t.type %></td>
                  <td>$<%= t.amount %></td>
                  <td>
                    <span class="badge badge-<%= t.status %>"><%= t.status %></span>
                    <% if (t.status === 'reversed' && t.reversal_reason) { %>
                      <div style="font-size:11px; color:var(--gray); margin-top:4px; font-style:italic;">Reason: <%= t.reversal_reason %></div>
                    <% } %>
                  </td>
                  <td>
                    <% if (t.status === 'completed') { %>
                      <button type="button" class="btn btn-navy btn-sm" style="padding:3px 10px; background:#7f1d1d;" onclick="openReverseModal(<%= t.id %>, '<%= t.type %>', $<%= t.amount %>)">⇄ Reverse</button>
                    <% } else if (t.status === 'reversed') { %>
                      <form action="/admin/transactions/<%= t.id %>/restore" method="POST" style="display:inline;"><button class="btn btn-gold btn-sm" style="padding:3px 10px;">↺ Restore</button></form>
                    <% } else { %>
                      <span style="color:var(--gray); font-size:12px;">—</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>

      <div class="dash-panel">
        <div class="dash-panel-title">Withdrawals</div>
        <% if (withdrawals.length === 0) { %>
          <p style="color:var(--gray); text-align:center; padding:20px; font-size:14px;">No withdrawals.</p>
        <% } else { %>
          <table class="table">
            <thead><tr><th>Date</th><th>Amount</th><th>Currency</th><th>Status</th></tr></thead>
            <tbody>
              <% withdrawals.forEach(function(w) { %>
                <tr><td style="font-size:12px;"><%= new Date(w.created_at).toLocaleDateString() %></td><td>$<%= w.amount %></td><td><%= w.currency %></td><td><span class="badge badge-<%= w.status %>"><%= w.status %></span></td></tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>

    <div class="dash-panel" style="margin-top:24px;">
      <div class="dash-panel-title">User Activity Log</div>
      <% if (activities.length === 0) { %>
        <p style="color:var(--gray); text-align:center; padding:20px; font-size:14px;">No activity logged.</p>
      <% } else { %>
        <table class="table">
          <thead><tr><th>Action</th><th>Details</th><th>IP</th><th>Time</th></tr></thead>
          <tbody>
            <% activities.forEach(function(a) { %>
              <tr><td style="text-transform:capitalize; font-weight:600;"><%= a.action %></td><td style="font-size:13px;"><%= a.details %></td><td style="font-size:12px; color:var(--gray);"><%= a.ip_address || '—' %></td><td style="font-size:12px; color:var(--gray);"><%= new Date(a.created_at).toLocaleString() %></td></tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- Generate Single Transaction -->
    <div class="dash-panel" style="margin-top:24px; border:1px solid rgba(212,175,55,0.3);">
      <div class="dash-panel-title" style="color:var(--gold);">⚡ Generate Transaction for This User</div>
      <% if (req_query_generated) { %>
        <div style="background:rgba(46,204,113,0.15); border:1px solid rgba(46,204,113,0.3); color:var(--green); padding:12px 16px; border-radius:8px; margin-bottom:16px; font-weight:600;">✅ Transaction generated successfully! It now appears in the user's transaction history.</div>
      <% } %>
      <p style="color:var(--gray); font-size:14px; margin-bottom:16px;">Add a deposit, withdrawal, or interest transaction to this user's account. The transaction will appear in their history and optionally adjust their balance.</p>
      <form action="/admin/users/<%= user.id %>/generate-transaction" method="POST">
        <div class="form-row">
          <div class="form-group">
            <label>Transaction Type <span class="req">*</span></label>
            <select name="type" class="form-control" required>
              <option value="deposit">💰 Deposit</option>
              <option value="withdrawal">🏦 Withdrawal</option>
              <option value="interest">📈 Interest / ROI Payout</option>
              <option value="bonus">🎁 Bonus</option>
            </select>
          </div>
          <div class="form-group">
            <label>Amount ($) <span class="req">*</span></label>
            <input type="number" name="amount" class="form-control" placeholder="e.g. 500.00" step="0.01" min="0.01" required>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Description (optional)</label>
            <input type="text" name="description" class="form-control" placeholder="e.g. Crypto deposit via USDT (TRC-20)">
          </div>
          <div class="form-group">
            <label>Status</label>
            <select name="status" class="form-control">
              <option value="completed">Completed</option>
              <option value="pending">Pending</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
            <input type="checkbox" name="adjust_balance" value="yes" checked style="width:18px; height:18px;">
            <span>Adjust user balance (add/subtract from their account balance)</span>
          </label>
        </div>
        <button type="submit" class="btn btn-gold btn-block">⚡ Generate Transaction</button>
      </form>
    </div>
  </main>
</div>

<!-- Reverse reason modal -->
<div class="reverse-modal-overlay" id="reverseModalOverlay" onclick="if(event.target===this) closeReverseModal()">
  <div class="reverse-modal">
    <h3>⇄ Reverse Transaction</h3>
    <div class="rm-sub">Reversing will undo the balance effect, mark the transaction as <strong>reversed</strong> in the user's dashboard, and email the user with your reason. This can be undone later with Restore.</div>
    <div class="rm-target" id="rmTarget"></div>
    <label style="display:block; color:var(--white); font-size:13px; font-weight:600; margin-bottom:8px;">Reason for reversal <span style="color:#e74c3c;">*</span></label>
    <textarea id="rmReason" maxlength="500" placeholder="Explain why you are reversing this transaction (the user will see this reason by email and in their dashboard)..."></textarea>
    <div class="rm-error" id="rmError">Please enter a reason before reversing.</div>
    <div class="rm-actions">
      <button type="button" class="btn btn-navy btn-sm" onclick="closeReverseModal()">Cancel</button>
      <button type="button" class="btn btn-gold btn-sm" id="rmConfirm" onclick="submitReverse()">⇄ Reverse Now</button>
    </div>
  </div>
</div>

<script>
  var rmTxnId = null;
  function openReverseModal(txnId, txnType, amount) {
    rmTxnId = txnId;
    var label = txnType.charAt(0).toUpperCase() + txnType.slice(1);
    document.getElementById('rmTarget').textContent = label + ' — ' + amount;
    document.getElementById('rmReason').value = '';
    document.getElementById('rmError').style.display = 'none';
    document.getElementById('reverseModalOverlay').classList.add('open');
    setTimeout(function(){ document.getElementById('rmReason').focus(); }, 60);
  }
  function closeReverseModal() {
    document.getElementById('reverseModalOverlay').classList.remove('open');
    rmTxnId = null;
  }
  function submitReverse() {
    var reason = document.getElementById('rmReason').value.trim();
    if (!reason) {
      document.getElementById('rmError').style.display = 'block';
      return;
    }
    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '/admin/transactions/' + rmTxnId + '/reverse';
    var input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'reason';
    input.value = reason;
    form.appendChild(input);
    document.body.appendChild(form);
    form.submit();
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeReverseModal();
  });
</script>
</body>
</html>
