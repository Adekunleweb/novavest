<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="admin-layout">
  <%- include('../partials/admin-sidebar', { active }) %>
  <main class="admin-main">
    <div class="admin-header">
      <div>
        <h1>📨 Message Center</h1>
        <div class="sub" style="color:var(--gray);">Email individual users, broadcast everyone, and send tempting campaign messages</div>
      </div>
      <div class="mc-hero-stat">
        <span class="mc-hero-num"><%= totalUsers %></span>
        <span class="mc-hero-label">Active Users</span>
      </div>
    </div>

    <!-- Tabs -->
    <div class="mc-tabs">
      <button class="mc-tab active" data-tab="individual">✉️ Message Individual</button>
      <button class="mc-tab" data-tab="broadcast">📢 Broadcast All</button>
      <button class="mc-tab" data-tab="templates">🎯 Campaign Templates</button>
      <button class="mc-tab" data-tab="custom">➕ My Templates</button>
    </div>

    <!-- ============ TAB: INDIVIDUAL (matches generate-transactions UX) ============ -->
    <div class="mc-pane active" id="pane-individual">
      <div class="dash-panel" style="border:1px solid rgba(212,175,55,0.3);">
        <div class="dash-panel-title" style="color:var(--gold);">✉️ Send a Personal Email to One User</div>
        <p style="color:var(--gray); font-size:14px; margin-bottom:20px;">
          Pick a user from the dropdown, write your message, and send. The message is emailed to them directly and also saved in their support chat — just like generating a transaction for an individual.
        </p>
        <form id="indForm">
          <div class="form-group" style="margin-bottom:20px;">
            <label>Select User <span class="req">*</span></label>
            <select id="indUser" class="form-control" required>
              <option value="">Choose a user...</option>
              <% users.forEach(function(u) { %>
                <option value="<%= u.id %>" data-name="<%= u.full_name %>" data-email="<%= u.email %>"><%= u.full_name %> — <%= u.email %> (Balance: $<%= (u.balance||0).toLocaleString() %>)</option>
              <% }) %>
            </select>
          </div>
          <div class="form-group" style="margin-bottom:20px;">
            <label>Use a Pre-written Message (optional)</label>
            <select id="indPreset" class="form-control" onchange="applyPreset(this, 'indSubject', 'indBody')">
              <option value="">— Write my own message —</option>
              <optgroup label="🆕 New Investors (encourage to start)">
                <% templates.filter(t => t.category === 'New Investors').forEach(function(t) { %>
                  <option value="<%= t.id %>"><%= t.title %></option>
                <% }) %>
              </optgroup>
              <optgroup label="📈 Grow Portfolio (invest more)">
                <% templates.filter(t => t.category === 'Grow Your Portfolio').forEach(function(t) { %>
                  <option value="<%= t.id %>"><%= t.title %></option>
                <% }) %>
              </optgroup>
              <optgroup label="⏰ Limited-Time Offers">
                <% templates.filter(t => t.category === 'Limited-Time Offers').forEach(function(t) { %>
                  <option value="<%= t.id %>"><%= t.title %></option>
                <% }) %>
              </optgroup>
              <optgroup label="🤝 Re-Engagement">
                <% templates.filter(t => t.category === 'Re-Engagement').forEach(function(t) { %>
                  <option value="<%= t.id %>"><%= t.title %></option>
                <% }) %>
              </optgroup>
              <% if (customTemplates.length) { %>
                <optgroup label="📝 My Custom Templates">
                  <% customTemplates.forEach(function(t) { %>
                    <option value="custom_<%= t.id %>"><%= t.title %></option>
                  <% }) %>
                </optgroup>
              <% } %>
            </select>
            <small style="color:var(--gray);">Pick one to auto-fill the subject & message. You can edit it before sending. {{name}} is replaced with the user's name.</small>
          </div>
          <div class="form-group"><label>Subject <span class="req">*</span></label><input type="text" id="indSubject" class="form-control" placeholder="Email subject line" required maxlength="160"></div>
          <div class="form-group"><label>Message <span class="req">*</span></label><textarea id="indBody" class="form-control" rows="8" placeholder="Type your personal message to this user…" required></textarea></div>
          <button type="submit" class="btn btn-gold btn-block" id="indSend">✉️ Send Personal Email to User</button>
          <div id="indStatus" style="margin-top:12px;font-size:14px;"></div>
        </form>
      </div>
    </div>

    <!-- ============ TAB: BROADCAST ============ -->
    <div class="mc-pane" id="pane-broadcast">
      <div class="dash-panel" style="border:1px solid rgba(100,149,237,0.3);">
        <div class="dash-panel-title" style="color:#6495ED;">📢 Broadcast to ALL Users</div>
        <p style="color:var(--gray); font-size:14px; margin-bottom:20px;">
          Send an announcement to every user. Saved to each user's Announcements inbox and emailed to all <%= totalUsers %> users with the official ApexCrestVest template. Users can reply from their dashboard.
        </p>
        <form id="broadcastForm">
          <div class="form-group" style="margin-bottom:20px;">
            <label>Use a Pre-written Message (optional)</label>
            <select id="bPreset" class="form-control" onchange="applyPreset(this, 'bSubject', 'bBody')">
              <option value="">— Write my own message —</option>
              <optgroup label="🆕 New Investors">
                <% templates.filter(t => t.category === 'New Investors').forEach(function(t) { %>
                  <option value="<%= t.id %>"><%= t.title %></option>
                <% }) %>
              </optgroup>
              <optgroup label="📈 Grow Portfolio">
                <% templates.filter(t => t.category === 'Grow Your Portfolio').forEach(function(t) { %>
                  <option value="<%= t.id %>"><%= t.title %></option>
                <% }) %>
              </optgroup>
              <optgroup label="⏰ Limited-Time Offers">
                <% templates.filter(t => t.category === 'Limited-Time Offers').forEach(function(t) { %>
                  <option value="<%= t.id %>"><%= t.title %></option>
                <% }) %>
              </optgroup>
              <optgroup label="🤝 Re-Engagement">
                <% templates.filter(t => t.category === 'Re-Engagement').forEach(function(t) { %>
                  <option value="<%= t.id %>"><%= t.title %></option>
                <% }) %>
              </optgroup>
            </select>
          </div>
          <div class="form-group"><label>Subject <span class="req">*</span></label><input type="text" id="bSubject" class="form-control" placeholder="e.g. New Investment Plan Now Available" required maxlength="160"></div>
          <div class="form-group"><label>Message <span class="req">*</span></label><textarea id="bBody" class="form-control" rows="8" placeholder="Type your announcement here…" required></textarea></div>
          <button type="submit" class="btn btn-gold btn-block" id="bSend">📢 Send to All <%= totalUsers %> Users</button>
          <div id="bStatus" style="margin-top:12px;font-size:14px;"></div>
        </form>
      </div>
    </div>

    <!-- ============ TAB: TEMPLATES (browse tempting messages) ============ -->
    <div class="mc-pane" id="pane-templates">
      <div class="dash-panel">
        <div class="dash-panel-title">🎯 Pre-written Campaign Messages</div>
        <p style="color:var(--gray);font-size:14px;margin:0 0 18px;">A library of tempting messages to encourage users to invest more, get non-investors to try, and run time-limited offers. Use the dropdowns above on the Individual or Broadcast tabs, or browse them here and send with one click.</p>
        <div class="mc-tpl-cat-filter" id="tplCats"></div>
        <div id="tplList" class="mc-tpl-list"></div>
      </div>
    </div>

    <!-- ============ TAB: CUSTOM TEMPLATES ============ -->
    <div class="mc-pane" id="pane-custom">
      <div class="dash-panel">
        <div class="dash-panel-title">➕ Save Your Own Template</div>
        <p style="color:var(--gray);font-size:14px;margin:0 0 18px;">Write a reusable message template. Use <code>{{name}}</code> and <code>{{balance}}</code> as placeholders — they're replaced with each user's details when sent.</p>
        <form id="saveTplForm">
          <div class="form-row" style="grid-template-columns:2fr 1fr;">
            <div class="form-group"><label>Title</label><input type="text" id="tplTitle" class="form-control" placeholder="e.g. Holiday Promo" required></div>
            <div class="form-group"><label>Category</label><input type="text" id="tplCat" class="form-control" placeholder="e.g. Promotions"></div>
          </div>
          <div class="form-group"><label>Subject</label><input type="text" id="tplSubject" class="form-control" placeholder="Email subject — use {{name}} if desired" required></div>
          <div class="form-group"><label>Body</label><textarea id="tplBody" class="form-control" rows="5" placeholder="Message body — use {{name}}, {{balance}} as variables" required></textarea></div>
          <button type="submit" class="btn btn-navy">💾 Save Template</button>
          <span id="tplSaveStatus" style="font-size:14px;color:var(--gray);margin-left:12px;"></span>
        </form>
      </div>
      <% if (customTemplates.length) { %>
      <div class="dash-panel">
        <div class="dash-panel-title">📝 Your Saved Templates (<%= customTemplates.length %>)</div>
        <div class="mc-tpl-list">
          <% customTemplates.forEach(function(t) { %>
            <div class="mc-tpl-card">
              <div class="mc-tpl-head"><span class="mc-tpl-cat"><%= t.category %></span><span class="mc-tpl-src">Custom</span></div>
              <div class="mc-tpl-title"><%= t.title %></div>
              <div class="mc-tpl-subject"><strong>Subject:</strong> <%= t.subject %></div>
              <div class="mc-tpl-body"><%= t.body.substring(0, 200) %><%= t.body.length > 200 ? '…' : '' %></div>
              <div class="mc-tpl-actions">
                <button class="btn btn-gold btn-sm use-custom" data-id="<%= t.id %>" data-title="<%= t.title %>">📤 Send This</button>
                <form action="/admin/messages/templates/<%= t.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete this template?')">
                  <button type="submit" class="btn btn-navy btn-sm">🗑 Delete</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
      <% } %>
    </div>

    <!-- ============ CAMPAIGN HISTORY (shared) ============ -->
    <div class="dash-panel" style="margin-top:24px;">
      <div class="dash-panel-title">📋 Campaign History</div>
      <% if (campaigns.length === 0) { %>
        <div class="mc-empty"><div style="font-size:44px;margin-bottom:12px;">📭</div><p style="font-weight:600;color:var(--navy);">No campaigns yet</p><p style="font-size:14px;color:var(--gray);">Your sent messages will appear here.</p></div>
      <% } else { %>
        <div class="table-wrap"><table class="table"><thead><tr><th>Subject</th><th>Audience</th><th>Recipients</th><th>Sent By</th><th>Date</th><th>Actions</th></tr></thead><tbody>
          <% campaigns.forEach(function(c) { %>
            <tr><td style="font-weight:600;color:var(--navy);"><%= c.subject %></td><td><span class="badge-soft"><%= c.audience %></span></td><td><%= c.recipient_count %></td><td><%= c.sent_by || '—' %></td><td style="color:var(--gray);font-size:13px;"><%= new Date(c.created_at).toLocaleString() %></td><td><button class="btn btn-navy btn-sm view-replies" data-id="<%= c.id %>" data-subject="<%= c.subject %>">💬 Replies</button></td></tr>
          <% }) %>
        </tbody></table></div>
      <% } %>
    </div>
  </main>
</div>

<!-- Replies modal -->
<div class="mc-modal" id="repliesModal"><div class="mc-modal-card">
  <div class="mc-modal-head"><div><div class="mc-modal-title">💬 Replies</div><div class="mc-modal-sub" id="rmSubject"></div></div><button class="mc-modal-close" id="rmClose">✕</button></div>
  <div class="mc-modal-body" id="rmBody"><div class="mc-empty"><p style="color:var(--gray);">Loading…</p></div></div>
</div></div>

<!-- Template send (custom) modal -->
<div class="mc-modal" id="tplSendModal"><div class="mc-modal-card">
  <div class="mc-modal-head"><div><div class="mc-modal-title" id="tsTitle">Send Template</div></div><button class="mc-modal-close" id="tsClose">✕</button></div>
  <div class="mc-modal-body" id="tsBody"></div>
</div></div>

<!-- Template data for JS (built-in) -->
<script id="tplData" type="application/json"><%- JSON.stringify(templates) %></script>
<script id="customTplData" type="application/json"><%- JSON.stringify(customTemplates) %></script>

<script>
const esc = (s) => String(s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const allTemplates = JSON.parse(document.getElementById('tplData').textContent);
const customTemplates = JSON.parse(document.getElementById('customTplData').textContent);

// ===== Apply a preset template to a subject/body field pair =====
function applyPreset(sel, subjectId, bodyId) {
  if (!sel.value) return;
  let t = null;
  if (String(sel.value).indexOf('custom_') === 0) {
    const cid = String(sel.value).replace('custom_', '');
    t = customTemplates.find(x => String(x.id) === cid);
  } else {
    t = allTemplates.find(x => x.id === sel.value);
  }
  if (!t) return;
  let nameHint = '{{name}}';
  const userSel = document.getElementById('indUser');
  if (userSel && userSel.selectedOptions[0]) nameHint = userSel.selectedOptions[0].dataset.name || '{{name}}';
  document.getElementById(subjectId).value = t.subject.replace(/\{\{\s*name\s*\}\}/gi, nameHint);
  document.getElementById(bodyId).value = t.body.replace(/\{\{\s*name\s*\}\}/gi, nameHint);
}

// ===== Tab switching =====
document.querySelectorAll('.mc-tab').forEach(t => t.addEventListener('click', () => {
  document.querySelectorAll('.mc-tab').forEach(x => x.classList.remove('active'));
  document.querySelectorAll('.mc-pane').forEach(x => x.classList.remove('active'));
  t.classList.add('active');
  document.getElementById('pane-' + t.dataset.tab).classList.add('active');
  if (t.dataset.tab === 'templates') renderTemplateBrowser();
}));

// ===== Individual send =====
document.getElementById('indForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const userId = document.getElementById('indUser').value;
  const subject = document.getElementById('indSubject').value.trim();
  const body = document.getElementById('indBody').value.trim();
  const st = document.getElementById('indStatus');
  if (!userId) { st.style.color='var(--red)'; st.textContent = '✗ Please select a user first.'; return; }
  if (!subject || !body) return;
  const btn = document.getElementById('indSend');
  btn.disabled = true; btn.textContent = 'Sending…'; st.textContent = '';
  try {
    const r = await fetch('/admin/messages/send-individual', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ userId, subject, body }) });
    const d = await r.json();
    if (d.success) { st.style.color='var(--green)'; st.innerHTML = '✓ Email sent to <strong>'+esc(d.userName)+'</strong> ('+esc(d.userEmail)+'). Also saved to their support chat.'; document.getElementById('indSubject').value=''; document.getElementById('indBody').value=''; document.getElementById('indPreset').value=''; }
    else { st.style.color='var(--red)'; st.textContent = '✗ ' + (d.error||'Failed'); }
  } catch { st.style.color='var(--red)'; st.textContent = '✗ Network error'; }
  finally { btn.disabled = false; btn.textContent = '✉️ Send Personal Email to User'; }
});

// ===== Broadcast send =====
document.getElementById('broadcastForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const subject = document.getElementById('bSubject').value.trim();
  const body = document.getElementById('bBody').value.trim();
  if (!subject || !body) return;
  if (!confirm('Send to ALL <%= totalUsers %> users via email and dashboard?')) return;
  const btn = document.getElementById('bSend'); const st = document.getElementById('bStatus');
  btn.disabled = true; btn.textContent = 'Sending…'; st.textContent = '';
  try {
    const r = await fetch('/admin/messages/send', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ subject, body, audience:'all' }) });
    const d = await r.json();
    if (d.success) { st.style.color='var(--green)'; st.textContent = '✓ Sent to ' + d.recipient_count + ' users. Emails dispatched.'; e.target.reset(); setTimeout(()=>location.reload(), 1800); }
    else { st.style.color='var(--red)'; st.textContent = '✗ ' + (d.error||'Failed'); }
  } catch { st.style.color='var(--red)'; st.textContent = '✗ Network error'; }
  finally { btn.disabled = false; btn.textContent = '📢 Send to All <%= totalUsers %> Users'; }
});

// ===== Template browser (Templates tab) =====
function renderTemplateBrowser() {
  const cats = [...new Set(allTemplates.map(t => t.category))];
  const cf = document.getElementById('tplCats');
  cf.innerHTML = '<button class="mc-cat active" data-cat="all">All</button>' + cats.map(c => '<button class="mc-cat" data-cat="'+esc(c)+'">'+esc(c)+'</button>').join('');
  cf.querySelectorAll('.mc-cat').forEach(b => b.addEventListener('click', () => { cf.querySelectorAll('.mc-cat').forEach(x=>x.classList.remove('active')); b.classList.add('active'); renderTplList(b.dataset.cat); }));
  renderTplList('all');
}
function renderTplList(cat) {
  const filtered = cat === 'all' ? allTemplates : allTemplates.filter(t => t.category === cat);
  const box = document.getElementById('tplList');
  if (!filtered.length) { box.innerHTML = '<div class="mc-empty"><p style="color:var(--gray);">No templates.</p></div>'; return; }
  box.innerHTML = filtered.map(t => `<div class="mc-tpl-card">
    <div class="mc-tpl-head"><span class="mc-tpl-cat">${esc(t.category)}</span><span class="mc-tpl-src">Built-in</span></div>
    <div class="mc-tpl-title">${esc(t.title)}</div>
    <div class="mc-tpl-subject"><strong>Subject:</strong> ${esc(t.subject)}</div>
    <div class="mc-tpl-body">${esc(t.body).substring(0,240)}${t.body.length>240?'…':''}</div>
    <div class="mc-tpl-actions">
      <button class="btn btn-gold btn-sm tpl-to-ind" data-id="${esc(t.id)}">✉️ Send to Individual</button>
      <button class="btn btn-navy btn-sm tpl-to-all" data-id="${esc(t.id)}">📢 Send to All</button>
    </div></div>`).join('');
  box.querySelectorAll('.tpl-to-ind').forEach(b => b.addEventListener('click', () => {
    // jump to individual tab and prefill
    document.querySelector('.mc-tab[data-tab="individual"]').click();
    document.getElementById('indPreset').value = b.dataset.id;
    document.getElementById('indPreset').dispatchEvent(new Event('change'));
    document.getElementById('indUser').focus();
    document.querySelector('#pane-individual').scrollIntoView({behavior:'smooth'});
  }));
  box.querySelectorAll('.tpl-to-all').forEach(b => b.addEventListener('click', async () => {
    if (!confirm('Send this template to ALL <%= totalUsers %> users?')) return;
    const r = await fetch('/admin/messages/templates/send', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ templateId: b.dataset.id, source:'builtin', mode:'all' }) });
    const d = await r.json();
    if (d.success) { alert('✓ Sent to ' + d.recipient_count + ' users!'); location.reload(); }
    else alert('✗ ' + (d.error || 'Failed'));
  }));
}

// ===== Save custom template =====
document.getElementById('saveTplForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const payload = { title: document.getElementById('tplTitle').value.trim(), category: document.getElementById('tplCat').value.trim() || 'Custom', subject: document.getElementById('tplSubject').value.trim(), body: document.getElementById('tplBody').value.trim() };
  const st = document.getElementById('tplSaveStatus'); st.textContent = 'Saving…';
  try {
    const r = await fetch('/admin/messages/templates/save', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const d = await r.json();
    if (d.success) { st.style.color='var(--green)'; st.textContent = '✓ Saved!'; e.target.reset(); setTimeout(()=>location.reload(), 1200); }
    else { st.style.color='var(--red)'; st.textContent = '✗ Failed'; }
  } catch { st.style.color='var(--red)'; st.textContent = '✗ Network error'; }
});

// ===== Custom template "Send This" =====
document.querySelectorAll('.use-custom').forEach(btn => btn.addEventListener('click', () => {
  const id = btn.dataset.id; const title = btn.dataset.title;
  const modal = document.getElementById('tplSendModal');
  document.getElementById('tsTitle').textContent = 'Send: ' + title;
  document.getElementById('tsBody').innerHTML = `
    <div class="form-group"><label>Send to</label>
      <select id="ctMode" class="form-control"><option value="all">All Users (Broadcast)</option><option value="individual">Individual User</option></select></div>
    <div class="form-group" id="ctUserWrap" style="display:none;"><label>Select user</label>
      <select id="ctUser" class="form-control"><option value="">Choose a user...</option>
      <% users.forEach(function(u) { %><option value="<%= u.id %>"><%= u.full_name %> — <%= u.email %></option><% }) %>
      </select></div>
    <div style="margin-top:14px;"><button class="btn btn-gold" id="ctConfirm">📤 Send Now</button><span id="ctStatus" style="margin-left:12px;font-size:14px;color:var(--gray);"></span></div>`;
  modal.classList.add('open');
  document.getElementById('ctMode').addEventListener('change', e => document.getElementById('ctUserWrap').style.display = e.target.value==='individual'?'block':'none');
  document.getElementById('ctConfirm').addEventListener('click', async () => {
    const mode = document.getElementById('ctMode').value;
    const payload = { templateId: id, source: 'custom', mode };
    if (mode === 'individual') { const uid = document.getElementById('ctUser').value; if (!uid) { document.getElementById('ctStatus').style.color='var(--red)'; document.getElementById('ctStatus').textContent='Select a user.'; return; } payload.userId = uid; }
    if (mode === 'all' && !confirm('Send to ALL <%= totalUsers %> users?')) return;
    const r = await fetch('/admin/messages/templates/send', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const d = await r.json();
    if (d.success) { document.getElementById('ctStatus').style.color='var(--green)'; document.getElementById('ctStatus').textContent='✓ Sent to ' + d.recipient_count + ' user(s)!'; setTimeout(()=>{ modal.classList.remove('open'); location.reload(); }, 1500); }
    else { document.getElementById('ctStatus').style.color='var(--red)'; document.getElementById('ctStatus').textContent='✗ ' + (d.error||'Failed'); }
  });
}));

// ===== Replies modal =====
const rmodal = document.getElementById('repliesModal');
document.querySelectorAll('.view-replies').forEach(btn => btn.addEventListener('click', async () => {
  document.getElementById('rmSubject').textContent = btn.dataset.subject;
  document.getElementById('rmBody').innerHTML = '<div class="mc-empty"><p style="color:var(--gray);">Loading…</p></div>';
  rmodal.classList.add('open');
  try {
    const r = await fetch('/admin/messages/campaign/' + btn.dataset.id + '/replies'); const d = await r.json();
    if (!d.replies || !d.replies.length) { document.getElementById('rmBody').innerHTML = '<div class="mc-empty"><div style="font-size:36px;">🤷</div><p style="color:var(--gray);">No replies yet.</p></div>'; return; }
    document.getElementById('rmBody').innerHTML = d.replies.map(r => `<div class="mc-reply"><div class="mc-reply-head"><span class="mc-reply-name">${esc(r.full_name)}</span><span class="mc-reply-email">${esc(r.email)}</span><span class="mc-reply-time">${new Date(r.created_at).toLocaleString()}</span></div><div class="mc-reply-msg">${esc(r.message)}</div><a href="/admin/support" class="btn btn-navy btn-sm" style="margin-top:10px;">💬 Reply in Support</a></div>`).join('');
  } catch { document.getElementById('rmBody').innerHTML = '<div class="mc-empty"><p style="color:var(--red);">Failed.</p></div>'; }
}));
document.getElementById('rmClose').addEventListener('click', () => rmodal.classList.remove('open'));
rmodal.addEventListener('click', e => { if (e.target === rmodal) rmodal.classList.remove('open'); });
document.getElementById('tsClose').addEventListener('click', () => document.getElementById('tplSendModal').classList.remove('open'));
